{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "3.6.1",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "24": "images/icon24.png",
      "32": "images/icon32.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "core/platforms.js",
        "scripts/contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/statusOn.png",
        "images/statusOff.png",
        "platforms/whatsapp/css/messages.css",
        "platforms/whatsapp/css/messagesPreview.css",
        "platforms/whatsapp/css/mediaPreview.css",
        "platforms/whatsapp/css/mediaGallery.css",
        "platforms/whatsapp/css/textInput.css",
        "platforms/whatsapp/css/profilePic.css",
        "platforms/whatsapp/css/name.css",
        "platforms/whatsapp/css/noDelay.css",
        "platforms/whatsapp/css/unblurActive.css",
        "platforms/instagram/css/messages.css",
        "platforms/instagram/css/messagesPreview.css",
        "platforms/instagram/css/mediaGallery.css",
        "platforms/instagram/css/mediaPreview.css",
        "platforms/instagram/css/profilePic.css",
        "platforms/instagram/css/name.css",
        "platforms/instagram/css/noDelay.css",
        "platforms/instagram/css/unblurActive.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*"
      ]
    }
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Toggle On/Off"
    }
  }
}
